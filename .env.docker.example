# Copy to .env.docker. Compose >= 2.30 is required.
# These two values are used by: docker compose --env-file .env.docker ...
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Injected into backend at runtime; no .env file is baked into either image.
# DB_PROFILE labels the connection; DB_* below actually select the database.
DB_PROFILE=local
PACKAGE_WORKFLOW_ENABLED=true
CORS_ORIGINS=http://localhost:3000
HOSPITAL_QUEUE_CALLBACK_ENABLED=false

# SQL Server on the Docker host (Docker Desktop or Linux host-gateway).
# For a remote SQL Server replace with its reachable IP/hostname.
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_runtime_database_user
# Raw env_file: write the literal password without wrapping quotes.
DB_PASSWORD=replace_with_real_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
REALTIME_DATASET_EPOCH=local-v1

# Set both only if enabling the existing force-release admin action.
# DISPENSING_ADMIN_USERNAME=replace_with_admin_username
# DISPENSING_ADMIN_PASSWORD=replace_with_admin_password
