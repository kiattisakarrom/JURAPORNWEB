NODE_ENV=development
DB_PROFILE=local
PACKAGE_WORKFLOW_ENABLED=true
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Test-only hospital callback (disabled by default, never enabled in production).
HOSPITAL_CALLBACK_TEST_ENABLED=false
HOSPITAL_QUEUE_CALLBACK_ENABLED=false

# Required only for the web action that force-releases a stuck dispensing channel.
# Store real credentials only in the ignored .env.local/.env.live files.
DISPENSING_ADMIN_USERNAME=change_me
DISPENSING_ADMIN_PASSWORD=change_me

DB_HOST=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000

# Change this value after restoring/replacing a database under the same host/name.
REALTIME_DATASET_EPOCH=local-v1
