{
  "name": "juraporn-api",
  "version": "0.1.0",
  "description": "NestJS API for Juraporn pharmacy workflows",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test:realtime:local": "node scripts/test-realtime-local.js",
    "db:bundle": "node scripts/build-sql-bundle.js",
    "db:bundle:check": "node scripts/build-sql-bundle.js --check",
    "db:install:local": "node scripts/install-fullstack-database.js local",
    "db:install:live": "node scripts/install-fullstack-database.js live",
    "db:install:test:local": "node scripts/test-fullstack-installer-local.js",
    "db:realtime:local": "node scripts/run-sql-file.js --profile local sql/005_enable_realtime_sync.sql",
    "db:realtime:validate:local": "node scripts/run-sql-file.js --profile local sql/006_validate_realtime_sync.sql",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "node scripts/run-profile-command.js local nest start --watch",
    "start:dev:local": "node scripts/run-profile-command.js local nest start --watch",
    "start:dev:live": "node scripts/run-profile-command.js live nest start --watch",
    "start:prod": "node dist/main.js",
    "start:prod:local": "node scripts/run-profile-command.js local node dist/main.js",
    "start:prod:live": "node scripts/run-profile-command.js live node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:package:local": "node scripts/run-sql-file.js --profile local sql/001_create_package_workflow_schema.sql",
    "db:package:live": "node scripts/run-sql-file.js --profile live sql/001_create_package_workflow_schema.sql",
    "db:package:validate:local": "node scripts/run-sql-file.js --profile local sql/003_validate_package_workflow.sql",
    "db:package:validate:live": "node scripts/run-sql-file.js --profile live sql/003_validate_package_workflow.sql",
    "db:workflow:cleanup:local": "node scripts/run-sql-file.js --profile local sql/002_drop_legacy_workflow_schema.sql",
    "db:seed:verify-alerts:local": "node scripts/run-sql-file.js --profile local sql/004_seed_verify_alert_test_data.sql",
    "db:verify-note:local": "node scripts/run-sql-file.js --profile local sql/008_add_verify_note_autosave.sql",
    "db:verify-note:live": "node scripts/run-sql-file.js --profile live sql/008_add_verify_note_autosave.sql",
    "db:dispensing:local": "node scripts/run-sql-file.js --profile local sql/009_dispensing_queue.sql"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mssql": "^12.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
